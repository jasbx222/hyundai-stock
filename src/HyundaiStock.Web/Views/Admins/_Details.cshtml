@model AdminRow
<div class="modal">
    <div class="mh"><div class="mic pr">@Ui.Icon("shield", 20)</div><div><h3>@Model.Name</h3><p>تفاصيل المشرف</p></div><button class="ib" data-close style="margin-inline-start:auto" aria-label="إغلاق">@Ui.Icon("x", 18)</button></div>
    <div class="kv">
        <div><span>رقم الهاتف</span><b class="mono" dir="ltr">@Model.PhoneNumber</b></div>
        <div><span>الدور</span><b>@Labels.Role(Model.Role)</b></div>
        <div><span>الفرع</span><b>@(Model.BranchName ?? "—")</b></div>
        <div><span>الحالة</span><b>@Ui.Active(Model.IsActive)</b></div>
        <div><span>تاريخ الإنشاء</span><b class="num">@Ui.DT(Model.CreatedAt)</b></div>
    </div>
    <div class="mf" style="margin-top:20px"><button class="btn" data-close>إغلاق</button></div>
</div>
