@model NewPartDetails
@{ ViewData["Title"] = "طلب إضافة قطعة"; ViewData["Nav"] = "newparts"; var r = Model.Request; }
<div class="ph"><div><h1>طلب @r.Reference</h1><p class="sub">@Labels.NewPart(r.Status)</p></div><div class="acts"><a class="btn" href="/NewParts">رجوع</a></div></div>
<div class="card" style="padding:18px;margin-bottom:16px">
    <div class="fg2">
        <div><span class="lbl">رقم القطعة</span><div class="mono">@r.PartNumber</div></div>
        <div><span class="lbl">الوصف</span><div>@r.Description</div></div>
        <div><span class="lbl">الكمية</span><div class="num">@r.Quantity</div></div>
        <div><span class="lbl">الموقع</span><div>@r.Location</div></div>
        <div><span class="lbl">الفرع</span><div>@r.BranchName</div></div>
        <div><span class="lbl">المخزن</span><div>@r.WarehouseName</div></div>
        <div><span class="lbl">الموظف</span><div>@r.EmployeeName</div></div>
        <div><span class="lbl">الجلسة</span><div>@r.SessionName</div></div>
        <div><span class="lbl">سبب الإرجاع</span><div>@(string.IsNullOrWhiteSpace(r.ReturnReason) ? "—" : r.ReturnReason)</div></div>
    </div>
</div>
<div class="card" style="overflow:hidden">
    <div class="hscroll"><table>
        <thead><tr><th>الإجراء</th><th>من</th><th>إلى</th><th>المنفّذ</th><th>الدور</th><th>السبب</th><th>الوقت</th></tr></thead>
        <tbody>
        @foreach (var h in Model.History) {
            <tr><td>@h.Action</td><td>@(h.FromStatus ?? "—")</td><td>@h.ToStatus</td><td>@h.Actor</td><td>@h.ActorRole</td><td>@(h.Reason ?? "—")</td><td>@Ui.DT(h.CreatedAt)</td></tr>
        }
        </tbody>
    </table></div>
</div>
