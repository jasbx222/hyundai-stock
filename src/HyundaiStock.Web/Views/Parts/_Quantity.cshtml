@model InventoryPart
@{
    var users = ViewBag.Users as List<NamedItem> ?? new List<NamedItem>();
}
<div class="modal"><form method="post" action="/Parts/Quantity/@Model.Id">
    @Html.AntiForgeryToken()<input type="hidden" name="returnUrl" />
    <div class="mh"><div class="mic pr">@Ui.Icon("edit", 20)</div><div><h3>تعديل الكمية</h3><p><span class="mono">@Model.PartNumber</span> · @Model.Description</p></div></div>
    <div class="mb" style="display:grid;gap:12px">
        <div class="fg2">
            <div><label class="lbl">الكمية في النظام</label><div class="field"><input class="num" value="@Model.SystemQuantity" readonly tabindex="-1" aria-readonly="true" /></div></div>
            <div><label class="lbl">الكمية الجديدة<i> *</i></label><div class="field"><input class="num" name="newQuantity" type="number" min="0" required placeholder="0" value="@Model.CountedQuantity" /></div></div>
        </div>
        <div>
            <label class="lbl">إرسال الطلب إلى<i> *</i></label>
            <div style="display:grid;gap:8px">
                <label class="opt"><input type="radio" name="audience" value="user" checked /> <span>مستخدم محدد</span></label>
                <div class="field"><select name="audienceUserId"><option value="">اختر المستخدم</option>@foreach (var u in users) { <option value="@u.Id">@u.Name</option> }</select></div>
                @if (users.Count == 0) { <span class="hint">لا يوجد مستخدم نشط مرتبط بمخزن هذه القطعة.</span> }
                @if (Model.BranchId is int bid)
                {
                    <label class="opt"><input type="radio" name="audience" value="branch" /> <span>كل مستخدمي فرع @(Model.Branch?.Name ?? "")</span></label>
                    <input type="hidden" name="audienceBranchId" value="@bid" />
                }
                @if (Model.WarehouseId is int wid)
                {
                    <label class="opt"><input type="radio" name="audience" value="warehouse" /> <span>كل مستخدمي مخزن @(Model.Warehouse?.Name ?? "")</span></label>
                    <input type="hidden" name="audienceWarehouseId" value="@wid" />
                }
                <span class="hint">اختيار الفرع أو المخزن يوصل الطلب لمستخدميه النشطين. اختيار مستخدم يوصله له وحده.</span>
            </div>
        </div>
    </div>
    <div class="mf"><button class="btn p" type="submit">حفظ</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div>
