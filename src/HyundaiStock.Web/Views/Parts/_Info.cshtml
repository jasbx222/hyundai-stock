@model InventoryPart
<div class="modal">
    <div class="mh"><div class="mic pr">@Ui.Icon("part", 20)</div><div><h3 class="mono">@Model.PartNumber</h3><p>@Model.Description</p></div><button class="ib" data-close style="margin-inline-start:auto" title="إغلاق" aria-label="إغلاق">@Ui.Icon("x", 18)</button></div>
    <div class="kv">
        <div><span>كمية النظام</span><b class="num">@Model.SystemQuantity</b></div>
        <div><span>الكمية المعدودة</span><b class="num">@(Model.CountedQuantity?.ToString() ?? "—")</b></div>
        <div><span>الفرق</span><b>@Ui.Diff(Model.CountedQuantity, Model.SystemQuantity)</b></div>
        <div><span>موقع النظام</span><b class="mono">@(Model.SystemLocation ?? "—")</b></div>
        <div><span>الموقع المعدود</span><b class="mono">@(Model.CountedLocation ?? "—")</b></div>
        <div><span>الفرع / المخزن</span><b>@(Model.Branch?.Name ?? "—") / @(Model.Warehouse?.Name ?? "—")</b></div>
        <div><span>عُدّت بواسطة</span><b>@(Model.CountedByUser?.Name ?? "—")</b></div>
        <div><span>وقت العد</span><b>@Ui.When(Model.CountedAt)</b></div>
        <div><span>الإحداثيات</span><b class="mono" dir="ltr">@(Model.Latitude.HasValue ? $"{Model.Latitude:F6}, {Model.Longitude:F6}" : "—")</b></div>
    </div>
    <div class="mf" style="margin-top:20px"><a class="btn p" href="/Parts/Details/@Model.Id">عرض التفاصيل</a><button class="btn" data-close>إغلاق</button></div>
</div>
