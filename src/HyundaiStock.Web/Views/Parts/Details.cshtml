@model PartDetails
@{ var p = Model.Part; ViewData["Title"] = p.PartNumber; ViewData["Nav"] = "parts"; string tab = ViewBag.Tab as string ?? "recounts"; if (tab is not ("recounts" or "logs")) tab = "recounts"; }
<div class="ph">
    <div style="display:flex;align-items:center;gap:12px"><h1 class="mono">@p.PartNumber</h1>@(Model.Indicator != null ? Ui.Badge(Model.Indicator, Model.Indicator == "مطابق" ? "ok" : "er") : Ui.Match(p.CountedQuantity, p.SystemQuantity))</div>
    <div class="acts"><a class="btn" href="/Parts">@Ui.Icon("arrowr", 16) رجوع</a></div>
</div>
<div class="card" style="padding:24px">
    <div class="kv kf">
        <div style="grid-column:1/-1"><span>الوصف</span><b>@p.Description</b></div>
        @if (Model.Indicator == null) { <div><span>الكمية في النظام</span><b class="num">@p.SystemQuantity</b></div> }
        <div><span>الكمية المحسوبة</span><b class="num">@(p.CountedQuantity?.ToString() ?? "—")</b></div>
        @if (Model.Indicator == null) {
            <div><span>الفرق</span><b>@Ui.Diff(p.CountedQuantity, p.SystemQuantity)</b></div>
            <div><span>الحالة</span><b>@Ui.Match(p.CountedQuantity, p.SystemQuantity)</b></div>
        } else { <div><span>المؤشر</span><b>@Model.Indicator</b></div> }
        <div><span>الموقع في المخزن</span><b class="mono">@(p.SystemLocation ?? "—")</b></div>
        <div><span>الموقع المحسوب</span><b class="mono">@(p.CountedLocation ?? "—")</b></div>
        <div><span>الفرع</span><b>@(p.Branch?.Name ?? "—")</b></div>
        <div><span>المستخدم</span><b>@(p.CountedByUser?.Name ?? "—")</b></div>
        <div><span>تاريخ الإنشاء</span><b class="mono" style="font-size:12px">@Ui.Date(p.CreatedAt)</b></div>
        <div><span>المخزن</span><b>@(p.Warehouse?.Name ?? "—")</b></div>
    </div>
</div>
<div class="card" style="margin-top:16px">
    <div class="tabs" role="tablist">
        <a href="?tab=recounts" data-tab="recounts" class="@(tab == "recounts" ? "on" : "")" role="tab">طلبات إعادة العد</a>
        <a href="?tab=logs" data-tab="logs" class="@(tab == "logs" ? "on" : "")" role="tab">سجل التغييرات</a>
    </div>
    <div class="tabpane @(tab == "recounts" ? "on" : "")" id="recounts">
        @if (Model.Recounts.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm("لا توجد بيانات", "تظهر هنا طلبات إعادة العد لهذه القطعة.", "refresh")) }
        else { <div class="hscroll"><table><thead><tr><th>الرقم</th><th>المستخدم</th><th>طلب بواسطة</th><th>الحالة</th><th>النتيجة</th><th>تاريخ الطلب</th><th>تاريخ الإكمال</th></tr></thead><tbody>
            @foreach (var r in Model.Recounts) { <tr><td><span class="idx">@Ui.Idx(r.Id)</span></td><td>@Ui.Who(r.UserName)</td><td>@Ui.Who(r.RequestedBy)</td><td>@Ui.Recount(r.Status)</td><td class="num">@(r.ResultQuantity?.ToString() ?? "—")</td><td>@Ui.When(r.CreatedAt)</td><td>@Ui.When(r.CompletedAt)</td></tr> }
        </tbody></table></div> }
    </div>
    <div class="tabpane @(tab == "logs" ? "on" : "")" id="logs">
        @if (Model.Logs.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm("لا توجد بيانات", "أي تغيير على القطعة ينسجل هنا.", "history")) }
        else { <div class="hscroll"><table><thead><tr><th>الحقل</th><th>القيمة القديمة</th><th>القيمة الجديدة</th><th>بواسطة</th><th>المصدر</th><th>التاريخ</th></tr></thead><tbody>
            @foreach (var l in Model.Logs) { <tr><td>@l.Field</td><td class="num">@(l.OldValue ?? "—")</td><td class="num"><b>@(l.NewValue ?? "—")</b></td><td>@l.ChangedBy</td><td>@l.Source</td><td>@Ui.When(l.CreatedAt)</td></tr> }
        </tbody></table></div> }
    </div>
</div>
