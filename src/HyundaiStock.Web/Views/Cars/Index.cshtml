@model PagedResult<VinRow>
@{ ViewData["Title"] = "المركبات"; ViewData["Nav"] = "cars"; var branches = (List<NamedItem>)ViewBag.Branches; var users = (List<NamedItem>)ViewBag.Users; var admins = (List<NamedItem>)ViewBag.Admins; }
<div class="ph">
    <div><h1>المركبات</h1></div>
    <div class="acts">
        <div class="dd"><button type="button" class="btn" data-dd aria-haspopup="menu" title="تصدير المركبات إلى ملف Excel حسب الفرع أو المسؤول أو المستخدم">@Ui.Icon("export", 16) تصدير</button><div class="menu">
            <a href="/Exports/Cars?all=true">@Ui.Icon("sheet", 16) الكل</a>
            <a href="#" data-modal="#exp-branch">@Ui.Icon("branch", 16) للفرع</a>
            <a href="#" data-modal="#exp-admin">@Ui.Icon("shield", 16) للمسؤول</a>
            <a href="#" data-modal="#exp-user">@Ui.Icon("user", 16) للمستخدم</a>
        </div></div>
        <a class="btn p" href="/Exports/Cars" title="تحميل ملف Excel بكل مركبات آخر جلسة">@Ui.Icon("export", 16) تصدير آخر جلسة</a>
    </div>
</div>
<div class="card" style="overflow:hidden">
    <div class="toolbar">@await Html.PartialAsync("_Search", "بحث...")</div>
    @if (Model.Items.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm(string.IsNullOrEmpty(Context.Request.Query["search"]) ? "لا توجد بيانات" : "لا توجد نتائج", "ستظهر هنا المركبات التي تُمسح من التطبيق.", "car")) }
    else {
    <div class="hscroll"><table>
        <thead><tr><th>الرقم</th><th>VIN</th><th>اسم الجلسة</th><th>المستخدم</th><th>المستودع</th><th>الفرع</th><th>الموقع</th><th>تاريخ الإضافة</th><th>الإجراءات</th></tr></thead>
        <tbody>
        @foreach (var v in Model.Items) {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            <tr><td><span class="idx">@Ui.Idx(v.Id)</span></td><td><span class="mono" dir="ltr">@v.Vin</span></td><td>جرد @v.SessionYear</td><td>@v.UserName</td><td>@v.WarehouseName</td><td>@v.BranchName</td>
                <td>@if (v.Latitude.HasValue) { <a class="coord mono" dir="ltr" target="_blank" rel="noopener" href="https://www.google.com/maps?q=@v.Latitude.Value.ToString(inv),@v.Longitude!.Value.ToString(inv)">@v.Latitude.Value.ToString("F4", inv), @v.Longitude.Value.ToString("F4", inv)</a> } else { <span class="muted">—</span> }</td>
                <td>@Ui.Day(v.CreatedAt)</td>
                <td><div class="ra"><a class="btn sm g" href="/Cars/Edit/@v.Id" title="تعديل" aria-label="تعديل">@Ui.Icon("edit", 16)</a></div></td></tr>
        }
        </tbody>
    </table></div>
    @await Html.PartialAsync("_Pager", PagerVm.Of(Model))
    }
</div>
<div class="ov" id="exp-branch" role="dialog" aria-modal="true"><div class="modal" style="width:440px"><form method="get" action="/Exports/Cars">
    <input type="hidden" name="all" value="true" />
    <div class="mh"><div class="mic pr">@Ui.Icon("export", 20)</div><div><h3>تصدير المركبات للفرع</h3></div></div>
    <div class="mb"><label class="lbl">الفرع<i> *</i></label><div class="field"><select name="BranchId" required><option value="">اختر</option>@foreach (var o in branches) { <option value="@o.Id">@o.Name</option> }</select></div></div>
    <div class="mf"><button class="btn p" type="submit" data-close-after>تصدير</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div></div>
<div class="ov" id="exp-admin" role="dialog" aria-modal="true"><div class="modal" style="width:440px"><form method="get" action="/Exports/Cars">
    <input type="hidden" name="all" value="true" />
    <div class="mh"><div class="mic pr">@Ui.Icon("export", 20)</div><div><h3>تصدير المركبات للمسؤول</h3></div></div>
    <div class="mb"><label class="lbl">المسؤول<i> *</i></label><div class="field"><select name="AdminId" required><option value="">اختر</option>@foreach (var o in admins) { <option value="@o.Id">@o.Name</option> }</select></div></div>
    <div class="mf"><button class="btn p" type="submit" data-close-after>تصدير</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div></div>
<div class="ov" id="exp-user" role="dialog" aria-modal="true"><div class="modal" style="width:440px"><form method="get" action="/Exports/Cars">
    <input type="hidden" name="all" value="true" />
    <div class="mh"><div class="mic pr">@Ui.Icon("export", 20)</div><div><h3>تصدير المركبات للمستخدم</h3></div></div>
    <div class="mb"><label class="lbl">المستخدم<i> *</i></label><div class="field"><select name="UserId" required><option value="">اختر</option>@foreach (var o in users) { <option value="@o.Id">@o.Name</option> }</select></div></div>
    <div class="mf"><button class="btn p" type="submit" data-close-after>تصدير</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div></div>
