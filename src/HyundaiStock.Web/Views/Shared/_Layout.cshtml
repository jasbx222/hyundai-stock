@{
    var s = Context.Items[AdminScopeFilter.Key] as AdminScope;
    string active = ViewData["Nav"] as string ?? "";
    string title = ViewData["Title"] as string ?? "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? "جرد هيونداي" : title + " · جرد هيونداي")</title>
    <link rel="icon" href="~/img/favicon.png" />
    <link rel="stylesheet" href="~/css/design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="pageload" id="pageload" aria-hidden="true">
    <div class="pageload-bar" aria-hidden="true"><i></i></div>
    <div class="pageload-status" role="status" aria-live="polite"><span class="bspin" aria-hidden="true"></span><span data-pageload-text>جارٍ التحميل</span></div>
</div>
@if (s == null)
{
    @RenderBody()
}
else
{
    var sys = new List<(string key, string icon, string text, string url, string tip)> { ("home", "home", "لوحة التحكم", "/", "ملخص الجرد والإحصائيات وآخر النشاطات") };
    if (Menu.Users(s)) sys.Add(("users", "users", "المستخدمين", "/Users", "مستخدمو تطبيق الجرد على الهاتف وفروعهم ومخازنهم"));
    if (Menu.Admins(s)) sys.Add(("admins", "shield", "المشرفين", "/Admins", "حسابات الدخول إلى لوحة التحكم وصلاحياتها"));
    if (Menu.Org(s)) sys.Add(("branches", "branch", "الفروع", "/Branches", "فروع الشركة وأرقامها في نظام هيونداي"));
    if (Menu.Org(s)) sys.Add(("warehouses", "box", "المخازن", "/Warehouses", "مخازن كل فرع وأرقامها"));
    var inv = new List<(string key, string icon, string text, string url, string tip)>();
    if (Menu.Requests(s)) inv.Add(("requests", "edit", "طلبات التعديل", "/Requests?kind=recount", Menu.QuantityTab(s) ? "طلبات إعادة العد وتصحيح الكمية" : "طلبات إعادة العد"));
    if (Menu.NewParts(s)) inv.Add(("newparts", "plus", "طلبات إضافة قطعة", "/NewParts", "طلبات إضافة قطعة غير موجودة في جلسة الجرد"));
    if (Menu.Parts(s)) inv.Add(("parts", "part", "قطع الغيار", "/Parts", "قطع الجلسة: كمية النظام والكمية المعدودة والفروقات"));
    if (Menu.Finance(s)) inv.Add(("finance", "export", "فروقات المخزون المالية", "/Finance", "كمية النظام والمعدودة والسعر والقيمة المالية"));
    if (Menu.Cars(s)) inv.Add(("cars", "car", "المركبات", "/Cars", "المركبات الممسوحة برقم الشاصي من التطبيق"));
    if (Menu.VinRequests(s)) inv.Add(("vinrequests", "vin", "طلبات تصحيح VIN", "/VinRequests", "طلبات تصحيح رقم الشاصي المرسلة من التطبيق"));
    if (Menu.Sessions(s)) inv.Add(("sessions", "session", "جلسات الجرد", "/Sessions", "بدء جلسة جرد برفع ملفات Excel وإنهاؤها وتحميلها"));
    <div class="app">
        <button type="button" class="navbtn" id="navbtn" aria-controls="sidenav" aria-expanded="false" aria-label="القائمة">@Ui.Icon("menu", 20)</button>
        <div class="navscrim" id="navscrim"></div>
        <aside class="side" id="sidenav">
            <button type="button" class="navx" id="navx" aria-label="إغلاق القائمة">@Ui.Icon("x", 18)</button>
            <div class="deco">@Html.Raw(IconSet.Deco)</div>
            <a class="brand" href="/" title="العودة إلى لوحة التحكم"><div class="lg"><img src="~/img/hy_emblem_white.png" alt="Hyundai" style="width:100%;height:100%;object-fit:contain" /></div><div><b>جرد هيونداي</b><span>هيونداي موتورز العراق</span></div></a>
            <div class="sidenav">
            <div class="grp" title="إعداد الحسابات والفروع والمخازن">إدارة النظام</div>
            @foreach (var n in sys) { <a class="nav @(n.key == active ? "on" : "")" href="@n.url" title="@n.tip" aria-label="@n.text: @n.tip">@Ui.Icon(n.icon)<span>@n.text</span></a> }
            <div class="grp" title="بيانات الجرد والطلبات">المخزون</div>
            @foreach (var n in inv) { <a class="nav @(n.key == active ? "on" : "")" href="@n.url" title="@n.tip" aria-label="@n.text: @n.tip">@Ui.Icon(n.icon)<span>@n.text</span></a> }
            </div>
            <div class="me">
                <div class="av" title="الحساب الحالي">@Ui.Initial(s.Name)</div>
                <div class="t"><b>@s.Name</b><span>@Labels.Role(s.Role)</span></div>
                <form method="post" action="/Account/Logout">@Html.AntiForgeryToken()<button type="submit" title="تسجيل الخروج" aria-label="تسجيل الخروج">@Ui.Icon("logout", 18)</button></form>
            </div>
        </aside>
        <main class="main" style="display:flex;flex-direction:column">
            <div class="page">
                @await Html.PartialAsync("_Flash")
                @RenderBody()
            </div>
            <div class="sysfoot"><span dir="ltr" style="unicode-bidi:isolate">© @Ui.Local(DateTime.UtcNow).Year. Hyundai Motors Iraq.</span></div>
        </main>
    </div>
    @await Html.PartialAsync("_ConfirmModal")
    <div class="ov" id="remote" role="dialog" aria-modal="true"></div>
}
<template id="ic-check">@Ui.Icon("check", 20)</template><template id="ic-x">@Ui.Icon("x", 20)</template><template id="ic-power">@Ui.Icon("power", 20)</template><template id="ic-trash">@Ui.Icon("trash", 20)</template><template id="ic-key">@Ui.Icon("key", 20)</template><template id="ic-branch">@Ui.Icon("branch", 20)</template><template id="ic-session">@Ui.Icon("session", 20)</template><template id="ic-vin">@Ui.Icon("vin", 20)</template><template id="ic-refresh">@Ui.Icon("refresh", 20)</template><template id="ic-edit">@Ui.Icon("edit", 20)</template>
<form id="af" class="sr">@Html.AntiForgeryToken()</form>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
