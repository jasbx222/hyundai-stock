@model PagedResult<SessionRow>
@{ ViewData["Title"] = "جلسات الجرد"; ViewData["Nav"] = "sessions"; var me = (AdminScope)Context.Items[AdminScopeFilter.Key]!; }
<div class="ph">
    <div><h1>جلسات الجرد</h1></div>
    <div class="acts"><a class="btn" href="/Sessions/Export?@Ui.FilterQuery(Context.Request, "search").TrimStart('&')" title="تحميل ملف Excel حسب الفلتر الحالي">@Ui.Icon("export", 16) تصدير Excel</a>@if (me.CanStartSession) { <button class="btn p" data-modal="#start-m">@Ui.Icon("plus", 16) بدء جلسة جرد جديدة</button> }</div>
</div>
@if (ViewBag.Active is string active)
{
    <div class="card" role="status" style="padding:14px 18px;margin-bottom:16px;border-inline-start:4px solid var(--warn, #d97706)">
        <b>توجد جلسة جرد مفتوحة: «@active»</b>
        <div class="muted">لا يمكن فتح جلسة جديدة (سنوية أو شهرية) قبل إنهاء هذه الجلسة. مدير الحسابات وحده يفتح الجلسة ويغلقها.</div>
    </div>
}
<div class="card" style="overflow:hidden">
    @if (Model.Items.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm("لا توجد بيانات", "ابدأ أول جلسة جرد برفع ملف Excel للقطع والمركبات.", "session")) }
    else {
    <div class="hscroll"><table>
        <thead><tr><th>الرقم</th><th>الجلسة</th><th>النوع</th><th>الحالة</th><th>بواسطة</th><th>تاريخ البدء</th><th>تاريخ الإنهاء</th><th>الملف</th><th>الإجراءات</th></tr></thead>
        <tbody>
        @foreach (var x in Model.Items) {
            var live = x.Status == SessionStatus.InProgress;
            <tr><td><span class="idx">@Ui.Idx(x.Id)</span></td><td><b>@(string.IsNullOrEmpty(x.Name) ? x.Year.ToString() : x.Name)</b></td><td>@Ui.Badge(Labels.SessionKindLabel(x.Kind), x.Kind == SessionKind.Monthly ? "in" : "mu")</td><td>@Ui.Session(x.Status)</td><td>@x.StartedBy</td><td>@Ui.Day(x.StartedAt)</td><td>@Ui.Day(x.EndedAt)</td>
                <td><span class="chip">@Ui.Icon("sheet", 14) <span class="mono">@x.FileName</span></span></td>
                <td><div class="ra">
                    <a class="btn sm g" href="/Sessions/File/@x.Id" title="عرض الملف" aria-label="عرض الملف">@Ui.Icon("file", 16)</a>
                    @if (Menu.LegacyExport(me)) {
                    <a class="btn sm g" href="/Exports/Parts?kind=all&sessionId=@x.Id" title="تصدير قطع الغيار" aria-label="تصدير قطع الغيار">@Ui.Icon("part", 16)</a>
                    <a class="btn sm g" href="/Exports/Cars?sessionId=@x.Id" title="تصدير VINs" aria-label="تصدير VINs">@Ui.Icon("vin", 16)</a>
                    <a class="btn sm g" href="/Exports/Parts?kind=uncounted&sessionId=@x.Id" title="تصدير غير محسوب" aria-label="تصدير غير محسوب">@Ui.Icon("layers", 16)</a>
                    <a class="btn sm g" href="/Exports/Vins?missing=true&sessionId=@x.Id" title="تصدير VINs غير موجودة" aria-label="تصدير VINs غير موجودة">@Ui.Icon("alert", 16)</a>
                    }
                    @if (live && me.CanEndSession) {
                        <span class="sep"></span>
                        <button type="button" class="btn sm dz" data-confirm data-action="/Sessions/End" data-hidden='{"id":"@x.Id"}' data-kind="d" data-icon="power" title="إنهاء الجلسة؟" data-title="إنهاء الجلسة؟" data-text="سيتم إنهاء «@x.Name»، ولن يتمكن المستخدمون من إرسال أي عدّ أو مسح بعدها." data-ok="إنهاء الجلسة">@Ui.Icon("power", 14) إنهاء الجلسة</button>
                    }
                </div></td></tr>
        }
        </tbody>
    </table></div>
    @await Html.PartialAsync("_Pager", PagerVm.Of(Model))
    }
</div>
<div class="ov" id="start-m" role="dialog" aria-modal="true"><div class="modal"><form method="post" action="/Sessions/Start" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="mh"><div class="mic pr">@Ui.Icon("upload", 20)</div><div><h3>بدء جلسة جرد جديدة</h3><p>ارفع ملف Excel أو أكثر بقطع الغيار وأرقام الشاصي</p></div></div>
    <div class="mb">
        @{ var now = Ui.Local(DateTime.UtcNow); }
        <label class="lbl" for="session-kind">نوع الجرد</label>
        <div class="field"><select id="session-kind" name="kind" onchange="document.getElementById('session-month-row').hidden = this.value !== 'Monthly'">
            <option value="Annual">جرد سنوي</option>
            <option value="Monthly">جرد شهري</option>
        </select></div>
        <label class="lbl" for="session-year">سنة الجرد</label>
        <div class="field"><input id="session-year" name="year" type="number" min="2000" max="2100" required value="@now.Year" dir="ltr" /></div>
        <div id="session-month-row" hidden>
            <label class="lbl" for="session-month">الشهر</label>
            <div class="field"><select id="session-month" name="month">
                @for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(m == now.Month)">@m - @Labels.MonthName(m)</option> }
            </select></div>
        </div>
        <p class="hint">جرد سنوي واحد لكل سنة، وجرد شهري واحد لكل شهر، بما فيها الجلسات المكتملة. الجرد الشهري يشتغل مثل السنوي: قطع الغيار والسيارات، والفروقات تروح للحسابات. جلسة وحدة مفتوحة بنفس الوقت، فلازم تنهي أي جلسة مفتوحة أولاً. السنة والشهر يؤخذون من هذا الفورم، مو من ملف Excel.</p>
        <label class="drop">
            <input name="file" type="file" accept=".xlsx,.xls" multiple />
            @Ui.Icon("upload", 28)
            <b>اسحب الملفات هنا أو اخترها</b>
            <span class="hint">قالب الجرد (Parts / Vins)، أو تقارير النظام والتصدير. يدعم BranchNo. برقم الفرع أو Branch باسمه. سجّل الفروع والمخازن قبل الاستيراد. ملفات العناوين فقط لا تحتوي بيانات.</span>
            <span class="fn mono" dir="ltr"></span>
        </label>
        <div class="hint" style="margin-top:10px"><a href="/Sessions/Template">تحميل القالب</a></div>
    </div>
    <div class="mf"><button class="btn p" type="submit">بدء الجلسة</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div></div>
