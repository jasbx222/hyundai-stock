@model PagedResult<BranchRow>
@{ ViewData["Title"] = "الفروع"; ViewData["Nav"] = "branches"; var s = (AdminScope)Context.Items[AdminScopeFilter.Key]!; var manage = Menu.ManageOrg(s); }
<div class="ph">
    <div><h1>الفروع</h1><p>إدارة فروع الشركة والمخازن التابعة لها</p></div>
    <div class="toolbar">
        <a class="btn" href="/Exports/Branches">@Ui.Icon("export", 16) تصدير Excel</a>
        @if (manage) { <button class="btn p" data-modal="#branch-m" data-title="إضافة فرع" data-v-id="" data-form-action="/Branches/Save">@Ui.Icon("plus", 16) إضافة فرع</button> }
    </div>
</div>
<div class="card">
    <div class="ch">@await Html.PartialAsync("_Search", "ابحث باسم الفرع")</div>
    @if (Model.Items.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm("لا توجد فروع", string.IsNullOrEmpty(Context.Request.Query["search"]) ? "أضف أول فرع لبدء إدارة المخازن." : "ما في نتائج مطابقة للبحث.", "branch")) }
    else {
    <table>
        <thead><tr><th style="width:70px">الرقم</th><th>اسم الفرع</th><th>عدد المخازن</th><th style="width:90px">الإجراءات</th></tr></thead>
        <tbody>
        @foreach (var b in Model.Items) {
            <tr><td class="idx mono">@Ui.Idx(b.Id)</td><td><b>@b.Name</b></td><td class="num">@b.Warehouses</td>
            <td><div class="dd"><button class="ib" data-dd aria-label="الإجراءات">@Ui.Icon("more", 18)</button><div class="menu">
                <a href="/Warehouses?branchId=@b.Id">@Ui.Icon("box", 16) عرض المخازن</a>
                <a href="/Exports/Warehouses?branchId=@b.Id">@Ui.Icon("export", 16) تصدير المخازن</a>
                @if (manage) {
                    <a href="#" data-modal="#branch-m" data-title="تعديل الفرع" data-v-id="@b.Id" data-v-name="@b.Name" data-form-action="/Branches/Save">@Ui.Icon("edit", 16) تعديل</a>
                    <a href="#" class="dz" data-confirm data-action="/Branches/Delete" data-hidden='{"id":"@b.Id"}' data-kind="d" data-icon="trash" data-title="حذف الفرع" data-text="راح يتم حذف الفرع «@b.Name». ما يمكن حذف فرع عنده مخازن أو بيانات مرتبطة." data-ok="حذف">@Ui.Icon("trash", 16) حذف</a>
                }
            </div></div></td></tr>
        }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager", PagerVm.Of(Model))
    }
</div>
@if (manage) {
<div class="ov" id="branch-m" role="dialog" aria-modal="true"><div class="modal"><form method="post" action="/Branches/Save">
    @Html.AntiForgeryToken()<input type="hidden" name="id" />
    <div class="mh"><div class="mic pr">@Ui.Icon("branch", 20)</div><div><h3 data-title-slot>إضافة فرع</h3><p>أدخل اسم الفرع</p></div></div>
    <div class="fg"><div><label class="lbl">اسم الفرع<i> *</i></label><div class="field"><input name="name" required maxlength="150" placeholder="مثال: فرع بغداد" /></div></div></div>
    
    <div class="mf"><button class="btn p" type="submit">حفظ</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div></div>
}
