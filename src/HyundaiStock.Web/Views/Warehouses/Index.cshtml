@model PagedResult<WarehouseRow>
@{ ViewData["Title"] = "المخازن"; ViewData["Nav"] = "warehouses"; var s = (AdminScope)Context.Items[AdminScopeFilter.Key]!; var manage = Menu.ManageOrg(s);
   var branches = (List<NamedItem>)ViewBag.Branches; int? bid = ViewBag.BranchId; }
<div class="ph">
    <div><h1>المخازن</h1></div>
    <div class="acts">@if (manage) { <button class="btn p" data-modal="#wh-m" data-title="إضافة مخزن" data-v-id="" data-v-name="" data-v-number="" data-v-branchId="@(bid?.ToString() ?? "")" data-form-action="/Warehouses/Save">@Ui.Icon("plus", 16) إضافة مخزن</button> }</div>
</div>
<div class="card" style="overflow:hidden">
    <div class="toolbar">
        @await Html.PartialAsync("_Search", "بحث...")
        <form method="get">
            <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
            <label class="sel"><select name="branchId" onchange="this.form.submit()" aria-label="الفرع"><option value="">جميع الفروع</option>@foreach (var b in branches) { <option value="@b.Id" selected="@(bid == b.Id)">@b.Name</option> }</select>@Ui.Icon("chev", 14)</label>
        </form>
    </div>
    @if (Model.Items.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm(string.IsNullOrEmpty(Context.Request.Query["search"]) && bid == null ? "لا توجد بيانات" : "لا توجد نتائج", "ما في مخازن مطابقة. أضف مخزن جديد أو غيّر الفلتر.", "box")) }
    else {
    <table>
        <thead><tr><th>الرقم</th><th>رقم المخزن</th><th>اسم المخزن</th><th>النوع</th><th>الفرع</th><th>الإجراءات</th></tr></thead>
        <tbody>
        @foreach (var w in Model.Items) {
            <tr><td><span class="idx">@Ui.Idx(w.Id)</span></td><td class="mono">@(w.Number?.ToString() ?? "—")</td><td><b>@w.Name</b></td><td>@Ui.Badge(Labels.Type(w.Type), "mu nd")</td><td>@w.BranchName</td>
            <td><div class="ra">
                <a class="btn sm" href="/Exports/Parts?kind=all&WarehouseId=@w.Id">@Ui.Icon("export", 16) تصدير</a>
                <a class="btn sm" href="/Exports/Vins?missing=true&WarehouseId=@w.Id">@Ui.Icon("vin", 16) تصدير VINs غير موجودة</a>
                @if (manage) {
                    <button type="button" class="btn sm g" title="تعديل" aria-label="تعديل" data-modal="#wh-m" data-title="تعديل المخزن" data-v-id="@w.Id" data-v-name="@w.Name" data-v-number="@w.Number" data-v-type="@((int)w.Type)" data-v-branchId="@w.BranchId" data-form-action="/Warehouses/Save">@Ui.Icon("edit", 16)</button>
                    <button type="button" class="btn sm g" title="حذف" aria-label="حذف" data-confirm data-action="/Warehouses/Delete" data-hidden='{"id":"@w.Id"}' data-kind="d" data-icon="trash" data-title="حذف المخزن؟" data-text="حذف «@w.Name» نهائي" data-ok="حذف">@Ui.Icon("trash", 16)</button>
                }
            </div></td></tr>
        }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager", PagerVm.Of(Model))
    }
</div>
@if (manage) {
<div class="ov" id="wh-m" role="dialog" aria-modal="true"><div class="modal"><form method="post" action="/Warehouses/Save">
    @Html.AntiForgeryToken()<input type="hidden" name="id" />
    <div class="mh"><div class="mic pr">@Ui.Icon("box", 20)</div><div><h3 data-title-slot>إضافة مخزن</h3></div></div>
    <div class="fg">
        <div><label class="lbl">اسم المخزن<i> *</i></label><div class="field"><input name="name" required maxlength="150" placeholder="أدخل اسم المخزن" /></div></div>
        <div><label class="lbl">رقم المخزن (WarehouseNo.) *</label><div class="field"><input name="number" type="number" required min="1" max="9999" inputmode="numeric" placeholder="مثال: 4" /></div></div>
        <div><label class="lbl">النوع<i> *</i></label><div class="field"><select name="type" required><option value="1">نوع 1</option><option value="2">نوع 2</option></select></div></div>
        <div><label class="lbl">الفرع<i> *</i></label><div class="field"><select name="branchId" required><option value="">اختر الفرع</option>@foreach (var b in branches) { <option value="@b.Id">@b.Name</option> }</select></div></div>
    </div>
    
    <div class="mf"><button class="btn p" type="submit">حفظ</button><button type="button" class="btn" data-close>إلغاء</button></div>
</form></div></div>
}
