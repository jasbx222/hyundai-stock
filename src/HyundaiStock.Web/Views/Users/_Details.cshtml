@model UserDetails
<div class="modal">
    <div class="mh"><div class="mic pr">@Ui.Icon("user", 20)</div><div><h3>@Model.Name</h3><p>تفاصيل المستخدم</p></div><button class="ib" data-close style="margin-inline-start:auto" aria-label="إغلاق">@Ui.Icon("x", 18)</button></div>
    <div class="kv">
        <div><span>رقم الهاتف</span><b class="mono" dir="ltr">@Model.PhoneNumber</b></div>
        <div><span>الفروع</span><b>@(Model.Branches.Count == 0 ? "—" : string.Join("، ", Model.Branches))</b></div>
        <div><span>المخازن</span><b>@(Model.Warehouses.Count == 0 ? "—" : string.Join("، ", Model.Warehouses))</b></div>
        <div><span>الحالة</span><b>@Ui.Active(Model.IsActive)</b></div>
        <div><span>تاريخ الإنشاء</span><b class="num">@Ui.DT(Model.CreatedAt)</b></div>
    </div>
    <div class="mf" style="margin-top:20px"><a class="btn p" href="/Users/Edit/@Model.Id">@Ui.Icon("edit", 16) تعديل</a><button class="btn" data-close>إغلاق</button></div>
</div>
