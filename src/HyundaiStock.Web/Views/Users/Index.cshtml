@model PagedResult<UserRow>
@{ ViewData["Title"] = "المستخدمين"; ViewData["Nav"] = "users"; }
<div class="ph">
    <div><h1>المستخدمين</h1></div>
    <div class="acts"><a class="btn p" href="/Users/Create">@Ui.Icon("plus", 16) إضافة مستخدم</a></div>
</div>
<div class="card" style="overflow:hidden">
    <div class="toolbar">@await Html.PartialAsync("_Search", "بحث...")</div>
    @if (Model.Items.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm(string.IsNullOrEmpty(Context.Request.Query["search"]) ? "لا توجد بيانات" : "لا توجد نتائج", string.IsNullOrEmpty(Context.Request.Query["search"]) ? "أضف مستخدمًا ليتمكن من تسجيل الدخول إلى تطبيق الجرد." : "جرّب اسمًا أو رقم هاتف آخر.", "users")) }
    else {
    <table>
        <thead><tr><th>الرقم</th><th>الاسم</th><th>رقم الهاتف</th><th>الفروع</th><th>المستودعات</th><th>الحالة</th><th>تاريخ الإنشاء</th><th>الإجراءات</th></tr></thead>
        <tbody>
        @foreach (var u in Model.Items) {
            <tr><td><span class="idx">@Ui.Idx(u.Id)</span></td>
                <td>@Ui.Who(u.Name)</td>
                <td><span class="mono">@u.PhoneNumber</span></td>
                <td>@(u.Branches.Count == 0 ? "—" : string.Join(" / ", u.Branches))</td>
                <td>@(u.Warehouses.Count == 0 ? "—" : u.Warehouses.Count > 2 ? $"{string.Join(" / ", u.Warehouses.Take(2))} +{u.Warehouses.Count - 2}" : string.Join(" / ", u.Warehouses))</td>
                <td>@Ui.Active(u.IsActive)</td><td>@Ui.Day(u.CreatedAt)</td>
                <td><div class="ra">
                    <button type="button" class="btn sm g" title="عرض التفاصيل" aria-label="عرض التفاصيل" data-remote="/Users/Details/@u.Id">@Ui.Icon("eye", 16)</button>
                    <a class="btn sm g" title="تعديل" aria-label="تعديل" href="/Users/Edit/@u.Id">@Ui.Icon("edit", 16)</a>
                    <a class="btn sm g" title="تصدير السيارات" aria-label="تصدير السيارات" href="/Exports/Cars?all=true&UserId=@u.Id">@Ui.Icon("car", 16)</a>
                    <a class="btn sm g" title="تصدير قطع الغيار" aria-label="تصدير قطع الغيار" href="/Exports/Parts?kind=counted&UserId=@u.Id">@Ui.Icon("part", 16)</a>
                    <span class="sep"></span>
                    @if (u.IsActive) {
                        <button type="button" class="btn sm dz" data-confirm data-action="/Users/SetActive" data-hidden='{"id":"@u.Id","active":"false"}' data-kind="d" data-icon="power" data-title="تعطيل المستخدم؟" data-text="@u.Name لن يتمكن من الدخول إلى التطبيق" data-ok="تعطيل">@Ui.Icon("power", 14) تعطيل</button>
                    } else {
                        <button type="button" class="btn sm en" data-confirm data-action="/Users/SetActive" data-hidden='{"id":"@u.Id","active":"true"}' data-kind="ok" data-icon="power" data-title="تفعيل المستخدم؟" data-text="@u.Name سيتمكن من الدخول مرة أخرى" data-ok="تفعيل">@Ui.Icon("power", 14) تفعيل</button>
                    }
                </div></td></tr>
        }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager", PagerVm.Of(Model))
    }
</div>
