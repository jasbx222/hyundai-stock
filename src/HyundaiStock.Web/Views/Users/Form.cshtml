@model UserInput
@{ int? id = ViewBag.Id; var edit = id.HasValue; ViewData["Title"] = edit ? "تعديل مستخدم" : "إضافة مستخدم"; ViewData["Nav"] = "users";
   var branches = (List<NamedItem>)ViewBag.Branches; var whs = (List<NamedItem>)ViewBag.Warehouses; var ms = ViewData.ModelState; }
<div class="ph"><div><h1>@ViewData["Title"]</h1></div></div>
<form class="card formcard" method="post" novalidate>
    @Html.AntiForgeryToken()
    @if (ms.ErrorOf("") is string ge) { <div class="alert er" style="margin-bottom:18px">@Ui.Icon("alert", 18)<span>@ge</span></div> }
    <div class="fg2">
        <div><label class="lbl" for="Name">الاسم<i> *</i></label><div class="@ms.Cls("Name")"><input id="Name" name="Name" value="@Model.Name" maxlength="150" required placeholder="أدخل الاسم" /></div>@ms.Err("Name")</div>
        <div><label class="lbl" for="PhoneNumber">رقم الهاتف<i> *</i></label><div class="@ms.Cls("PhoneNumber")"><input id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" inputmode="numeric" maxlength="11" required placeholder="07XXXXXXXXX" dir="ltr" class="mono" style="text-align:right" /></div>@ms.Err("PhoneNumber")<div class="hint">11 رقم يبدأ بـ 075 أو 076 أو 077 أو 078</div></div>
        <div><label class="lbl" for="Password">كلمة المرور @if (!edit) {<i> *</i>}</label><div class="@ms.Cls("Password")"><input id="Password" name="Password" type="password" minlength="6" autocomplete="new-password" placeholder="@(edit ? "اتركها فارغة إذا كنت لا تريد تغييرها" : "6 أحرف على الأقل")" /></div>@ms.Err("Password")</div>
        <div><label class="lbl" for="ConfirmPassword">تأكيد كلمة المرور @if (!edit) {<i> *</i>}</label><div class="@ms.Cls("ConfirmPassword")"><input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" placeholder="أعد كتابة كلمة المرور" /></div>@ms.Err("ConfirmPassword")</div>
        <div><label class="lbl">الفروع<i> *</i></label>
            <details class="msel @(ms.ErrorOf("BranchIds") != null ? "err" : "")" data-kind="branches"><summary><span data-ph="اختر الفروع"></span>@Ui.Icon("chev", 14)</summary><div class="opts">
                @foreach (var b in branches) { <label><input type="checkbox" name="BranchIds" value="@b.Id" data-name="@b.Name" checked="@Model.BranchIds.Contains(b.Id)" /> @b.Name</label> }
                @if (branches.Count == 0) { <p class="muted">لا توجد فروع</p> }
            </div></details>@ms.Err("BranchIds")</div>
        <div><label class="lbl">المستودعات<i> *</i></label>
            <details class="msel @(ms.ErrorOf("WarehouseIds") != null ? "err" : "")" data-kind="warehouses"><summary><span data-ph="اختر المستودعات"></span>@Ui.Icon("chev", 14)</summary><div class="opts">
                @foreach (var w in whs) { <label data-parent="@w.ParentId"><input type="checkbox" name="WarehouseIds" value="@w.Id" data-name="@w.Name" checked="@Model.WarehouseIds.Contains(w.Id)" /> @w.Name</label> }
                <p class="muted" data-no-wh>اختر فرع أولاً لعرض مخازنه</p>
            </div></details>@ms.Err("WarehouseIds")</div>
        <div style="grid-column:1/-1"><label class="allpick"><input type="checkbox" name="CanPickDuplicateRow" value="true" checked="@Model.CanPickDuplicateRow" /><span><b>اختيار السطر عند تكرار رقم القطعة</b></span></label>
            <div class="hint">إذا تكرر رقم القطعة بأكثر من سطر، يشوف المستخدم كل الأسطر برقم السطر والموقع ويختار واحد. بدون هذي الصلاحية يُجرد السطر الافتراضي (أول سطر غير معدود).</div></div>
    </div>
    <div class="facts"><button class="btn p" type="submit">حفظ</button><a class="btn" href="/Users">إلغاء</a></div>
</form>
