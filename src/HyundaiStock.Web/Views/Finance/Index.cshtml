@model PagedResult<ExportService.FinanceRow>
@{
    ViewData["Title"] = "فروقات المخزون المالية";
    ViewData["Nav"] = "finance";
    var f = (FinanceFilter)ViewBag.Filter;
    var branches = (List<NamedItem>)ViewBag.Branches;
    var warehouses = (List<NamedItem>)ViewBag.Warehouses;
    var sessions = (List<NamedItem>)ViewBag.Sessions;
    var me = (AdminScope)Context.Items[AdminScopeFilter.Key]!;
    string q = $"sessionId={f.SessionId}&branchId={f.BranchId}&warehouseId={f.WarehouseId}&partNumber={Uri.EscapeDataString(f.PartNumber ?? "")}&description={Uri.EscapeDataString(f.Description ?? "")}&difference={f.Difference}&sort={f.Sort}";
}
<div class="ph"><div><h1>فروقات المخزون المالية</h1></div><div class="acts"><a class="btn p" href="/Finance/Export?@q">@Ui.Icon("export", 16) تصدير</a></div></div>
<div class="card" style="overflow:hidden">
<form class="filters" method="get">
    <div><label class="lbl">الجلسة</label><div class="field"><select name="sessionId"><option value="">الأحدث</option>@foreach (var x in sessions) { <option value="@x.Id" selected="@(f.SessionId == x.Id)">@x.Name</option> }</select></div></div>
    <div><label class="lbl">الفرع</label><div class="field"><select name="branchId"><option value="">الكل</option>@foreach (var x in branches) { <option value="@x.Id" selected="@(f.BranchId == x.Id)">@x.Name</option> }</select></div></div>
    <div><label class="lbl">المخزن</label><div class="field"><select name="warehouseId"><option value="">الكل</option>@foreach (var x in warehouses) { <option value="@x.Id" selected="@(f.WarehouseId == x.Id)">@x.Name</option> }</select></div></div>
    <div><label class="lbl">رقم القطعة</label><div class="field"><input name="partNumber" value="@f.PartNumber" placeholder="ابحث برقم القطعة" /></div></div>
    <div><label class="lbl">الوصف</label><div class="field"><input name="description" value="@f.Description" placeholder="جزء من الوصف" /></div></div>
    <div><label class="lbl">الفرق</label><div class="field"><select name="difference">
        <option value="">الكل</option>
        <option value="shortage" selected="@(f.Difference == "shortage")">نقص</option>
        <option value="surplus" selected="@(f.Difference == "surplus")">زيادة</option>
        <option value="match" selected="@(f.Difference == "match")">متطابق</option>
        <option value="uncounted" selected="@(f.Difference == "uncounted")">غير معدود</option>
        <option value="diff" selected="@(f.Difference == "diff")">يوجد فرق</option>
    </select></div></div>
    <div><label class="lbl">الترتيب</label><div class="field"><select name="sort">
        <option value="part" selected="@(f.Sort == "part")">رقم القطعة</option>
        <option value="difference" selected="@(f.Sort == "difference")">الفرق</option>
        <option value="value" selected="@(f.Sort == "value")">القيمة</option>
    </select></div></div>
    <div class="go"><button class="btn p" type="submit">تصفية</button></div>
</form>
    @if (Model.Items.Count == 0) { @await Html.PartialAsync("_Empty", new EmptyVm("لا توجد بيانات", "لا توجد قطع مطابقة للتصفية.", "part")) }
    else {
    <div class="hscroll"><table>
        <thead><tr><th>رقم القطعة</th><th>الوصف</th><th>النظام</th><th>المعدود</th><th>الفرق</th><th>النوع</th><th>السعر</th><th>القيمة</th><th>الفرع</th><th>المخزن</th><th>الجلسة</th><th title="المستخدم الذي أكمل إعادة عد هذه القطعة">أعاد العد</th><th>الإجراءات</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Items) {
            <tr><td class="mono">@r.PartNumber</td><td class="clip">@r.Description</td><td class="num">@r.SystemQuantity</td><td class="num">@(r.CountedQuantity?.ToString() ?? "—")</td>
                <td>@Ui.Diff(r.CountedQuantity, r.SystemQuantity)</td><td>@Labels.Variance(r.CountedQuantity, r.SystemQuantity)</td><td class="num" dir="ltr">@r.Price.ToString("0.00")</td>
                <td class="num" dir="ltr">@(r.FinancialDifference?.ToString("0.00") ?? "—")</td><td>@(r.Branch ?? "—")</td><td>@(r.Warehouse ?? "—")</td><td>@r.Year</td>
                <td>@Ui.Who(r.RecountedBy)</td>
                <td>@if (r.Difference is int d && d != 0 && me.CanRequestRecount) { <button type="button" class="btn sm" data-remote="/Parts/RecountForm/@r.Id" title="إرسال القطعة إلى مستخدم لإعادة عدّها">@Ui.Icon("refresh", 16) إعادة العد</button> }</td></tr>
        }
        </tbody>
    </table></div>
    @await Html.PartialAsync("_Pager", PagerVm.Of(Model))
    }
</div>
